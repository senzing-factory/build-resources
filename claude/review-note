#!/usr/bin/env bash
# review-note -- record something the reviewer checked and found sound.
#
# Usage:  review-note <text...>
#
# The reviewer is told to use this for anything it looked at and found clean.
# That impulse is real and constant -- "no SQL injection in the new handler",
# "the version table is consistent" -- and the fourth requirement on this
# reviewer is that none of it reaches the comment AS A TICK BESIDE FINDINGS.
# Forbidding it in the prompt does not work on its own, because the text has
# nowhere else to go; this is the somewhere else.
#
# ~~review_output.py prints the file to the job log and never to a pull
# request.~~ CHANGED: it prints the file to the job log on every run, and on
# a CLEAN VERDICT it also renders the notes into the comment. A correct clean
# verdict with no evidence cannot be told from a review that did not happen,
# and this file is the evidence. The model is told so, because a channel
# described as reaching nobody is a channel nothing gets written to -- which
# is what was measured: on the run that prompted the change, the notes file
# was created, passed to the output step, and never written to once.
#
# WHY A WRAPPER AND NOT AN ALLOWED COMMAND. Claude Code's `Bash(cmd:*)`
# permission bounds the START of the command string and nothing after it, so
# the argument list is unconstrained -- which is why `Bash(git push:*)` is a
# remote-code-execution hole by way of `--receive-pack`, and why Anthropic's
# own action replaced that pattern with a wrapper. A wrapper is sound where a
# prefix is not, because the wrapper validates its own arguments, and this one
# is sound by construction: argv reaches exactly one `printf` as data, and the
# destination comes from the environment rather than from argv, so no argument
# can redirect the write.
#
# BOUNDS. A note is capped at NOTE_MAX characters and the file at FILE_MAX, so
# a loop cannot fill the runner's disk. Over either limit the note is refused
# with a message and a non-zero status, which the reviewer sees as a failed
# tool call rather than as silent acceptance.
#
# TEXT THAT WOULD FORGE THE COMMENT is refused the same way: `<!--` and
# `-->`. The state marker is an HTML comment read back out of the RAW comment
# body, so a note carrying either delimiter rewrites what a later run
# measures. review_output.py refuses them too, but SILENTLY -- so a note
# accepted here and dropped there is evidence the reviewer believes it
# recorded, and on a clean verdict that costs the tick. Rephrase the note.
#
# ~~A triple backtick is refused too, because the notes render inside a
# fence.~~ CHANGED: they render as paragraphs with their text escaped,
# so a backtick is ordinary text. The rule failed a tool call for quoting a
# fenced block, which is a thing a reviewer reasonably writes.
#
# REVIEW_NOTES names the file. Unset is an error, not a default path: a
# default would mean a copy of this running outside the workflow silently
# writes somewhere nobody reads.

usage() {
  awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"
  exit "${1:-2}"
}

set -euo pipefail

NOTE_MAX=500
FILE_MAX=65536

case "${1:-}" in
  -h | --help) usage 0 ;;
esac

if [ "$#" -eq 0 ]; then
  echo "review-note: nothing to record" >&2
  usage 2
fi

if [ -z "${REVIEW_NOTES:-}" ]; then
  echo "review-note: REVIEW_NOTES is not set; refusing to guess a path" >&2
  exit 2
fi

NOTE="$*"
if [ "${#NOTE}" -gt "$NOTE_MAX" ]; then
  echo "review-note: note is ${#NOTE} characters; the limit is ${NOTE_MAX}" >&2
  exit 2
fi

case "$NOTE" in
  *'<!--'* | *'-->'*)
    echo "review-note: a note cannot contain an HTML comment delimiter;" \
      "that text forges the comment's own state marker and the note would be" \
      "dropped. Rephrase it without the marker and record it again." >&2
    exit 2
    ;;
esac

if [ -f "$REVIEW_NOTES" ]; then
  SIZE=$(wc -c <"$REVIEW_NOTES")
else
  SIZE=0
fi
if [ "$SIZE" -ge "$FILE_MAX" ]; then
  echo "review-note: the notes file has reached ${FILE_MAX} bytes" >&2
  exit 2
fi

printf '%s\n' "$NOTE" >>"$REVIEW_NOTES"
echo "noted"
